# Copy to .env. Defaults run fully in sandbox mode with NO external accounts:
# the copy generator and brand-voice judge are deterministic, so the whole studio
# works offline and in CI. Never commit a real .env.

APP_ENV=local                          # local | ci | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Auth (JWT) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-use-a-48-byte-random-secret
JWT_ISSUER=campaign-studio
JWT_TTL_SECONDS=3600
SERVICE_ACCOUNT_ID=marketer
SERVICE_ACCOUNT_PASSWORD=local-dev-password

# --- Rate limiting (in-process token bucket; per subject/IP) ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- LLM (OpenAI-compatible; default targets local Ollama) ---
LLM_MODE=sandbox                       # sandbox | real
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=60

# --- Generation limits ---
MAX_SEGMENTS=8
MAX_VARIANTS_PER_SEGMENT=5
MAX_REQUEST_BYTES=262144
